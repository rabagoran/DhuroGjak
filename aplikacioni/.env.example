# Kopjoje si .env.local dhe plotëso vlerat. MOS e publiko .env.local në GitHub.

# Java 4 — Neon (Vercel → Storage → Neon, ose console.neon.tech → Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Java 5 — NextAuth + GitHub OAuth (github.com/settings/developers → New OAuth App)
# Callback URL lokal: http://localhost:3000/api/auth/callback/github
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gjenero-me-npx-auth-secret-ose-openssl-rand-base64-32
GITHUB_ID=
GITHUB_SECRET=
# Opsionale: Google (console.cloud.google.com → Credentials → OAuth client)
GOOGLE_ID=
GOOGLE_SECRET=
